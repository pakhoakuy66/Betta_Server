{
  "name": "betta_server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "recap:catch-up": "ts-node -r tsconfig-paths/register src/scripts/run-weekly-recap-catch-up.ts",
    "cleanup:dry-run": "node -r ts-node/register -r tsconfig-paths/register src/scripts/cleanup-retention.ts",
    "cleanup:run": "node -r ts-node/register -r tsconfig-paths/register src/scripts/cleanup-retention.ts --execute",
    "reactions:cleanup": "node -r ts-node/register -r tsconfig-paths/register src/scripts/cleanup-reactions.ts",
    "reactions:cleanup:run": "node -r ts-node/register -r tsconfig-paths/register src/scripts/cleanup-reactions.ts --execute",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test:integration:social": "jest --config ./test/jest-integration.json --runInBand --runTestsByPath test/integration/social-graph.integration-spec.ts",
    "test:integration:auth": "jest --config ./test/jest-integration.json --runInBand --runTestsByPath test/integration/auth-token.integration-spec.ts",
    "test:integration:auth-sessions-api": "jest --config ./test/jest-integration.json --runInBand --runTestsByPath test/integration/auth-sessions-api.integration-spec.ts",
    "test:integration:post-permission": "jest --config ./test/jest-integration.json --runInBand --runTestsByPath test/integration/post-permission.integration-spec.ts",
    "test:integration:cleanup": "jest --config ./test/jest-integration.json --runInBand --runTestsByPath test/integration/cleanup.integration-spec.ts",
    "test:integration:account-deletion": "jest --config ./test/jest-integration.json --runInBand --runTestsByPath test/integration/account-deletion.integration-spec.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.15",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/websockets": "^11.1.15",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^1.41.3",
    "mongoose": "^9.2.4",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nanoid": "^3.3.12",
    "nodemailer": "^8.0.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-dist": "^5.32.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
