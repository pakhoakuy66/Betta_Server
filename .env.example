# File mẫu để push lên Github
PORT=5000

# Copy link từ MongoDB Atlas vào đây
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/bettaDB?retryWrites=true&w=majority"

# JWT Secret Key
JWT_SECRET="your_jwt_secret_here"

# Cloudinary Setup for Uploads
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# --- EMAIL CONFIG (NODEMAILER) ---
MAIL_HOST=
MAIL_PORT=
# Email thật dùng để cấp mã:
MAIL_USER= 
# Mật khẩu ứng dụng (App Password 16 ký tự, KHÔNG PHẢI MẬT KHẨU ĐĂNG NHẬP!):
MAIL_PASS=
# Tên hiển thị khi gửi:
MAIL_FROM=

# ==========================================================
# AUTH RATE LIMIT
# ==========================================================

# Secret HMAC tối thiểu 32 ký tự. Không dùng chung JWT_SECRET.
AUTH_RATE_LIMIT_SECRET=replace_with_random_secret_minimum_32_characters

# Số reverse proxy đáng tin cậy. Local mặc định là 0.
TRUST_PROXY_HOPS=0

# ==========================================================
# LOGIN RATE LIMIT
# ==========================================================

# Giới hạn theo IP trong 15 phút.
AUTH_LOGIN_IP_LIMIT=20

# Giới hạn theo email/tài khoản trong 15 phút.
AUTH_LOGIN_ACCOUNT_LIMIT=10

# Cửa sổ tính bằng giây.
AUTH_LOGIN_WINDOW_SECONDS=900

# ==========================================================
# FORGOT PASSWORD RATE LIMIT
# ==========================================================

# Giới hạn gửi OTP theo IP trong 15 phút.
AUTH_FORGOT_IP_LIMIT=5

# Giới hạn gửi OTP theo email trong 15 phút.
AUTH_FORGOT_ACCOUNT_LIMIT=3

# Cửa sổ tính bằng giây.
AUTH_FORGOT_WINDOW_SECONDS=900

# ==========================================================
# VERIFY OTP / RESET PASSWORD RATE LIMIT
# ==========================================================

# Giới hạn chung cho Verify OTP và Reset Password theo IP.
AUTH_OTP_IP_LIMIT=20

# Giới hạn chung theo email.
AUTH_OTP_ACCOUNT_LIMIT=8

# Cửa sổ 10 phút, tính bằng giây.
AUTH_OTP_WINDOW_SECONDS=600
