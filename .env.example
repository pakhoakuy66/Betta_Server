# File mẫu để push lên Github
PORT=5000

# Copy link từ MongoDB Atlas vào đây
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/bettaDB?retryWrites=true&w=majority"

# JWT Secret Key
JWT_SECRET=replace_with_random_access_secret_minimum_32_characters
JWT_REFRESH_SECRET=replace_with_random_refresh_secret_minimum_32_characters

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
REFRESH_TOKEN_HASH_ROUNDS=10

# Cloudinary Setup for Uploads
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
# Thư mục gốc lưu tài nguyên Cloudinary.
# Local/developer: betta-dev
# Production: betta
CLOUDINARY_ROOT_FOLDER=betta/betta-dev

# --- EMAIL CONFIG (NODEMAILER) ---
MAIL_HOST=
MAIL_PORT=
# Email thật dùng để cấp mã:
MAIL_USER= 
# Mật khẩu ứng dụng (App Password 16 ký tự, KHÔNG PHẢI MẬT KHẨU ĐĂNG NHẬP!):
MAIL_PASS=
# Tên hiển thị khi gửi:
MAIL_FROM=

# ==========================================================
# AUTH RATE LIMIT
# ==========================================================

# Secret HMAC tối thiểu 32 ký tự. Không dùng chung JWT_SECRET.
AUTH_RATE_LIMIT_SECRET=replace_with_random_secret_minimum_32_characters

# Số reverse proxy đáng tin cậy giữa Internet và backend.
# Local/direct connection: 0.
# Đúng một Nginx/load balancer: 1.
# Không dùng trust proxy=true và không đoán số hop.
TRUST_PROXY_HOPS=0

# ==========================================================
# LOGIN RATE LIMIT
# ==========================================================

# Giới hạn theo IP trong 15 phút.
AUTH_LOGIN_IP_LIMIT=20

# Giới hạn theo email/tài khoản trong 15 phút.
AUTH_LOGIN_ACCOUNT_LIMIT=10

# Cửa sổ tính bằng giây.
AUTH_LOGIN_WINDOW_SECONDS=900

# ==========================================================
# FORGOT PASSWORD RATE LIMIT
# ==========================================================

# Giới hạn gửi OTP theo IP trong 15 phút.
AUTH_FORGOT_IP_LIMIT=5

# Giới hạn gửi OTP theo email trong 15 phút.
AUTH_FORGOT_ACCOUNT_LIMIT=3

# Cửa sổ tính bằng giây.
AUTH_FORGOT_WINDOW_SECONDS=900

# ==========================================================
# VERIFY OTP / RESET PASSWORD RATE LIMIT
# ==========================================================

# Giới hạn chung cho Verify OTP và Reset Password theo IP.
AUTH_OTP_IP_LIMIT=20

# Giới hạn chung theo email.
AUTH_OTP_ACCOUNT_LIMIT=8

# Cửa sổ 10 phút, tính bằng giây.
AUTH_OTP_WINDOW_SECONDS=600

# ==========================================================
# GOOGLE OAUTH TRANSACTION
# ==========================================================

# Contract môi trường Betta: developer | test | production
NODE_ENV=developer

GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Canonical Base64 của khóa ngẫu nhiên 32 byte.
# Không dùng chung JWT_SECRET hoặc JWT_REFRESH_SECRET.
GOOGLE_OAUTH_TRANSACTION_KEY_BASE64=

# Hợp lệ từ 300 đến 900 giây.
GOOGLE_OAUTH_TRANSACTION_TTL_SECONDS=600

# Google OAuth continuation grant lifetime: 120-900 seconds.
GOOGLE_OAUTH_CONTINUATION_GRANT_TTL_SECONDS=600

# lax cho FE/API cùng site; none chỉ dùng cross-site production HTTPS.
GOOGLE_OAUTH_CONTINUATION_COOKIE_SAME_SITE=lax

# Giới hạn khởi tạo Google OAuth theo IP trong 15 phút.
AUTH_GOOGLE_OAUTH_START_IP_LIMIT=20

# Cửa sổ rate limit tính bằng giây.
AUTH_GOOGLE_OAUTH_START_WINDOW_SECONDS=900

# Dedicated AES-256 key cho session handoff, canonical Base64 của 32 byte.
# Không dùng chung transaction key, JWT access secret hoặc JWT refresh secret.
GOOGLE_OAUTH_SESSION_HANDOFF_KEY_BASE64=

# Hợp lệ từ 60 đến 300 giây.
GOOGLE_OAUTH_SESSION_HANDOFF_TTL_SECONDS=120

# lax: frontend va API cung site, ke ca khi khac origin.
# none: chi dung production khi frontend va API cross-site that su.
# Moi request frontend -> API khac origin phai gui credentials.
# Backend phai dung exact CORS allowlist va credentials=true.
# Redeem endpoint voi SameSite=None phai kiem tra exact Origin.
GOOGLE_OAUTH_SESSION_HANDOFF_COOKIE_SAME_SITE=lax

# Exact Frontend origin used for fixed OAuth redirects.
# Must also be present in CORS_ALLOWED_ORIGINS.
# Production requires HTTPS.
GOOGLE_OAUTH_FRONTEND_ORIGIN=http://localhost:5173

# Session handoff redemption rate limit per trusted client IP.
AUTH_GOOGLE_OAUTH_SESSION_IP_LIMIT=30
AUTH_GOOGLE_OAUTH_SESSION_WINDOW_SECONDS=300

AUTH_GOOGLE_OAUTH_UNLINK_IP_LIMIT=20
AUTH_GOOGLE_OAUTH_UNLINK_USER_LIMIT=8
AUTH_GOOGLE_OAUTH_UNLINK_WINDOW_SECONDS=900

# Exact origins, phân tách bằng dấu phẩy.
# Không dùng wildcard, path, query hoặc credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Secret riêng, không dùng chung JWT_SECRET hoặc AUTH_RATE_LIMIT_SECRET.
REPORT_RATE_LIMIT_HASH_SECRET=replace_with_random_secret_minimum_32_characters

REPORT_RATE_LIMIT_TTL_BUFFER_SECONDS=60

REPORT_CONTENT_WINDOW_SECONDS=600
REPORT_CONTENT_USER_LIMIT=10
REPORT_CONTENT_IP_LIMIT=40
REPORT_CONTENT_DISTINCT_TARGET_LIMIT=8

REPORT_SYSTEM_WINDOW_SECONDS=600
REPORT_SYSTEM_USER_LIMIT=5
REPORT_SYSTEM_IP_LIMIT=20
REPORT_SYSTEM_DISTINCT_TARGET_LIMIT=3

# Guard chạy trước bước xử lý file.
REPORT_UPLOAD_WINDOW_SECONDS=600
REPORT_UPLOAD_USER_LIMIT=5
REPORT_UPLOAD_IP_LIMIT=20

ENABLE_REACTION_CLEANUP_CRON=
REACTION_CLEANUP_PRODUCTION_CONFIRMATION=

# Chỉ set tạm thời trong shell khi chủ động chạy execute.
LEGACY_REFRESH_TOKEN_MIGRATION_CONFIRMATION=

# Auth security audit retention. Valid range: 30-730 days.
AUTH_AUDIT_RETENTION_DAYS=180

# Admin runtime policy. Production phải khai báo tường minh.
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_REFRESH_TOKEN_TTL_SECONDS=604800
ADMIN_MAX_FAILED_LOGIN_ATTEMPTS=5
ADMIN_LOGIN_FAILURE_WINDOW_SECONDS=900
ADMIN_LOGIN_LOCK_DURATION_SECONDS=900

ADMIN_ACCESS_TOKEN_KEYRING_JSON=
ADMIN_REFRESH_TOKEN_KEYRING_JSON=
ADMIN_TOTP_ENCRYPTION_KEYRING_JSON=
ADMIN_CONTACT_ENCRYPTION_KEYRING_JSON=
ADMIN_CONTACT_LOOKUP_HMAC_KEYRING_JSON=